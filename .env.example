# Firebase Configuration
# 1. Go to Firebase Console → Project Settings → Your Apps
# 2. Register a Web App (</> icon) if you haven't already
# 3. Copy the config values below from the Firebase SDK config snippet
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_web_app_id_here

# TMDB Bearer Token (from https://www.themoviedb.org/settings/api)
VITE_TMDB_BEARER_TOKEN=your_tmdb_bearer_token
